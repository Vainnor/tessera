{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/terms/index.html",
        "http://localhost/license/index.html",
        "http://localhost/docs/index.html"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 4096 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
