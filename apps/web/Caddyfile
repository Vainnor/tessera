# Caddy config for the website image (apps/web/Dockerfile). Plain HTTP on :8080; TLS terminates
# at the reverse proxy in front. The headers must match public/_headers; test/headers.test.ts
# checks that.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	file_server
	# No access log: Caddy writes none unless a `log` directive asks for one, and the privacy page
	# promises nothing beyond what the reverse proxy keeps.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; manifest-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		-Server
	}
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
