{
  "name": "tessera",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:desktop": "pnpm --filter @vainnor/tessera-theme build && pnpm --filter @vainnor/tessera-desktop tauri dev",
    "dev:web": "pnpm --filter @vainnor/tessera-theme build && pnpm --filter @vainnor/tessera-web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:contrast": "pnpm --filter @vainnor/tessera-theme check:contrast",
    "check:size": "node scripts/check-bundle-size.ts",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
